# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Telegram ID админов через запятую
ADMIN_IDS=111111111
# Адрес панели Remnawave (без / в конце) и API-токен (Панель → Remnawave Settings → API Tokens)
# Если бот на одном сервере с панелью — лучше напрямую: http://127.0.0.1:3000
PANEL_URL=https://panel.example.com
API_TOKEN=eyJ...
# Только если панель закрыта секретной ссылкой reverse proxy (https://домен/auth/login?КЛЮЧ=ЗНАЧЕНИЕ):
# PANEL_COOKIE=КЛЮЧ=ЗНАЧЕНИЕ
PANEL_COOKIE=
# Если панель пускает только по клиентскому сертификату (mTLS) — пути к сертификату и ключу бота
PANEL_CLIENT_CERT=
PANEL_CLIENT_KEY=

# Значения по умолчанию для новых пользователей
DEFAULT_DAYS=31
# Рефералка: приглашённый получает REF_TRIAL_DAYS после одобрения; когда он впервые оплатит месяц
# (чек на REF_MIN_PAID_DAYS+ дней), обоим начисляется REF_PAID_BONUS_DAYS
REF_TRIAL_DAYS=7
REF_PAID_BONUS_DAYS=14
REF_MIN_PAID_DAYS=28
# Подарок в день рождения (только при активной подписке), 0 — выключить
BDAY_GIFT_DAYS=14
# Акция: первые N клиентов, привязавших Telegram к своей подписке, получают +M дней (0 — выключить)
FIRST_PROMO_LIMIT=20
FIRST_PROMO_DAYS=7
# Бонус за ПЕРВУЮ оплату через бота (первый одобренный чек на REF_MIN_PAID_DAYS+ дней) — любому клиенту.
# PAID_PROMO_DAYS=0 — выключить; PAID_PROMO_LIMIT — максимум человек (0 — без лимита)
PAID_PROMO_DAYS=7
PAID_PROMO_LIMIT=0
# Бонус за оплаты подряд: «месяцев:дней», после последней ступени цикл заново. Пусто — выключено.
# «Вовремя» — чек отправлен до окончания подписки (+ LOYAL_GRACE_HOURS).
LOYAL_TIERS=3:7,6:14
LOYAL_GRACE_HOURS=72
# Акция «первые N, оплатившие надолго»: чек от BIG_PROMO_MIN_DAYS дней → +BIG_PROMO_DAYS сверху всех бонусов.
# Один раз на подписку. BIG_PROMO_LIMIT=0 — выключено.
BIG_PROMO_LIMIT=0
BIG_PROMO_MIN_DAYS=124
BIG_PROMO_DAYS=31
# Лимит трафика в ГБ в месяц, 0 = безлимит
DEFAULT_TRAFFIC_GB=0
# Лимит устройств (HWID) для новых аккаунтов; 0 = не задавать, действует правило панели
DEFAULT_DEVICES=3
# UUID сквадов через запятую (если пусто — при создании выбираете кнопками)
DEFAULT_SQUAD_UUIDS=
# Префикс username в панели: tg_123456789 (совместимо со старым ботом)
USERNAME_PREFIX=tg_

# Текст, который видит пользователь при оплате (реквизиты и цена)
SUPPORT_TEXT=Стоимость 30 дней — 200 ₽. Перевод на карту 0000 0000 0000 0000 (Иван И.).

BOT_NAME=Бот
# ID группы (бот должен быть в ней админом). Можно не заполнять: когда админ первый раз
# тегнет бота в группе, бот представится, закрепит приветствие и сам запомнит группу
GROUP_CHAT_ID=
# Приветствие новичков: {name} — упоминание участника, \n — перенос строки (пусто = текст по умолчанию)
WELCOME_TEXT=
# Через сколько минут удалять приветствие (0 — не удалять)
WELCOME_DELETE_AFTER=10

# За сколько часов до окончания подписки напоминать (через запятую). Напоминания — только днём (10–21 МСК),
# одно сообщение закреплено вверху чата; после продления становится «✅ продлено».
REMIND_HOURS=72,24,6
# Одно догоняющее напоминание через N часов после окончания (0 — не напоминать)
REMIND_AFTER_HOURS=72
# Через сколько часов бот сам чистит переписку пользователей (0 — не чистить, максимум 47 — ограничение Telegram)
CHAT_AUTOCLEAN_HOURS=24

# Файл с known_hosts для SSH (пусто = ~/.ssh/known_hosts)
SSH_KNOWN_HOSTS=
DB_PATH=bot.db
